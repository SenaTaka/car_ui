        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将累计的距离、时间和油耗清零。"
          }
        }
      }
    },
    "車の OBD2 ポート(多くは運転席の足元)にアダプタを差し込みます。": {
      "localizations": {
        "de": {
          "stringUnit": {

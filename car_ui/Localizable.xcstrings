        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于测量 GPS 速度和记录行驶路线。"
          }
        }
      }
    },
    "GPS 速度・走行マップには位置情報が必要です。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für GPS-Geschwindigkeit und Streckenkarte wird der Standort benötigt."

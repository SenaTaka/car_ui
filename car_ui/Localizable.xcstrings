    "メーターの目盛りと、燃料流量 (0x5E) 非対応車での燃費推定に使います。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für die Skala der Anzeige und für die Verbrauchsschätzung bei Fahrzeugen ohne Kraftstoffdurchfluss (0x5E) verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for the gauge scale, and for estimating fuel economy on vehicles that do not support fuel rate (0x5E)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para la escala del medidor y para estimar el consumo en vehículos que no admiten caudal de combustible (0x5E)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour l’échelle du cadran et pour estimer la consommation sur les véhicules qui ne prennent pas en charge le débit de carburant (0x5E)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于仪表刻度，以及在不支持燃油流量 (0x5E) 的车辆上估算油耗。"
          }
        }
      }
    },
    "メーター画面右上の接続ボタンから、本物のアダプタへいつでも移れます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die Verbinden-Schaltfläche oben rechts im Dashboard können Sie jederzeit zu einem echten Adapter wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the connect button at the top right of the Dashboard to switch to a real adapter anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de conexión en la esquina superior derecha del panel para pasar a un adaptador real cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton de connexion en haut à droite du tableau de bord pour passer à un adaptateur réel à tout moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时通过仪表盘右上角的连接按钮切换到真实适配器。"
          }
        }
      }
    },

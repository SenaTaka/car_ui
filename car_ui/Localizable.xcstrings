    "* 燃費は吸入空気量(MAF)からの推定値です": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "* Der Kraftstoffverbrauch wird aus dem Luftmassenstrom (MAF) geschätzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* Fuel economy is estimated from mass air flow (MAF)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* El consumo se estima a partir del caudal de aire (MAF)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* La consommation est estimée à partir du débit d'air (MAF)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "* 油耗为根据进气流量(MAF)估算的数值"
          }
        }
      }
    },

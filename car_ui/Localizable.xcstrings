          "stringUnit": {
            "state": "translated",
            "value": "Los mosaicos digital/analógico usan una cuadrícula de 2 columnas; los gráficos y mapas ocupan todo el ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tuiles numériques/analogiques utilisent une grille à 2 colonnes ; les graphiques et cartes s'affichent sur toute la largeur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字/指针图块为两列网格排列,图表/地图则占满整个宽度显示。"

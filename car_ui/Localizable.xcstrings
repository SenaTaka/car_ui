    "iPhone では BLE 型 ELM327 アダプタを使用します。Bluetooth Classic SPP 型は iOS の公開 API では接続できません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie mit dem iPhone einen ELM327-Adapter vom Typ BLE. Adapter vom Typ Bluetooth Classic SPP können über die öffentlichen iOS-APIs nicht verbunden werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a BLE ELM327 adapter with iPhone. Bluetooth Classic SPP adapters cannot connect through public iOS APIs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone se usa un adaptador ELM327 tipo BLE. Los adaptadores Bluetooth Classic SPP no se pueden conectar mediante las API públicas de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un adaptateur ELM327 de type BLE avec iPhone. Les adaptateurs Bluetooth Classic SPP ne peuvent pas se connecter via les API publiques iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 使用 BLE 型 ELM327 适配器。Bluetooth Classic SPP 型无法通过 iOS 公开 API 连接。"
          }
        }
      }
    },

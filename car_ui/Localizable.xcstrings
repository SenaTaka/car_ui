    "フロントガラスの下に置いて反射で読み取ります。タップで操作ボタンを隠せます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie das Telefon unter die Windschutzscheibe und lesen Sie die Spiegelung ab. Tippen Sie, um die Bedienelemente auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the phone under the windshield and read the reflection. Tap to hide the controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócalo bajo el parabrisas y léelo por el reflejo. Toca para ocultar los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le téléphone sous le pare-brise et lisez le reflet. Appuyez pour masquer les commandes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放置于挡风玻璃下方,通过反射读取。轻点可隐藏操作按钮。"
          }
        }
      }
    },
    "プライバシー": {
      "localizations": {
        "de": {

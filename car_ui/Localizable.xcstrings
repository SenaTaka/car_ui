    "トルクの % 値の基準となるエンジン固有の基準トルクです。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das motorspezifische Referenzdrehmoment, auf dem die Drehmoment-Prozentwerte basieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine-specific reference torque that the torque percentages are based on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Par de referencia específico del motor en el que se basan los valores de par en porcentaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couple de référence propre au moteur, base des valeurs de couple exprimées en pourcentage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为扭矩百分比基准的发动机专属基准扭矩。"
          }
        }
      }
    },
    "ドライバーの操作から算出された要求トルクです(基準トルクに対する割合)。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aus der Fahrereingabe berechnete angeforderte Drehmoment (als Prozentsatz des Referenzdrehmoments)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torque demanded from driver input, as a percentage of reference torque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Par motor solicitado, calculado a partir de la acción del conductor (como porcentaje del par de referencia)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couple demandé, calculé à partir de l'action du conducteur (en pourcentage du couple de référence)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据驾驶员操作计算出的需求扭矩(占基准扭矩的百分比)。"
          }
        }
      }
    },

    "速度・回転数・水温など、車が発する対応データを自動検出して表示します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt automatisch die von Ihrem Auto unterstützten Daten — Geschwindigkeit, Drehzahl, Kühlmitteltemperatur und mehr — und zeigt sie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically detects and displays the data your car supports — speed, RPM, coolant temperature, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta y muestra automáticamente los datos que emite tu coche: velocidad, RPM, temperatura del refrigerante y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte et affiche automatiquement les données prises en charge par votre voiture — vitesse, RPM, température du liquide de refroidissement, et plus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测并显示车辆发出的支持数据,如速度、转速、水温等。"
          }
        }
      }
    },
    "速度・温度・圧力・燃費の表示単位です。CSV 書き出しもこの単位に従います(単位は列見出しに入ります)。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigeeinheiten für Geschwindigkeit, Temperatur, Druck und Verbrauch. CSV-Exporte folgen dieser Einstellung; die Einheit steht in der Spaltenüberschrift."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display units for speed, temperature, pressure and fuel economy. CSV exports follow this setting too, and the unit is written into the column header."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidades de visualización para velocidad, temperatura, presión y consumo. Las exportaciones CSV también siguen este ajuste y la unidad se escribe en el encabezado de columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unités d’affichage pour la vitesse, la température, la pression et la consommation. Les exports CSV suivent aussi ce réglage et l’unité figure dans l’en-tête de colonne."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速度、温度、压力和油耗的显示单位。CSV 导出同样遵循此设置，单位会写入列标题。"
          }
        }
      }
    },
    "進行方向の方位です(0° = 北、時計回り)。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrtrichtung (0° = Norden, im Uhrzeigersinn)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction of travel (0° = north, clockwise)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección de desplazamiento (0° = norte, en sentido horario)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction de déplacement (0° = nord, sens horaire)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行驶方向的方位角(0° = 北,顺时针)。"
          }

    "速度・回転数・水温など、車が発する対応データを自動検出して表示します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt automatisch die von Ihrem Auto unterstützten Daten — Geschwindigkeit, Drehzahl, Kühlmitteltemperatur und mehr — und zeigt sie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically detects and displays the data your car supports — speed, RPM, coolant temperature, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta y muestra automáticamente los datos que emite tu coche: velocidad, RPM, temperatura del refrigerante y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte et affiche automatiquement les données prises en charge par votre voiture — vitesse, RPM, température du liquide de refroidissement, et plus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测并显示车辆发出的支持数据,如速度、转速、水温等。"
          }
        }
      }
    },

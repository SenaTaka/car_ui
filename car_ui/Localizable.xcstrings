    "距離・時間・燃費の積算をゼロに戻します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die aufsummierte Strecke, Zeit und den Kraftstoffverbrauch auf null zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets accumulated distance, time, and fuel economy to zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece a cero la distancia, el tiempo y el consumo acumulados."
          }
        },

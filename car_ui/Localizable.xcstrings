            "state": "translated",
            "value": "Engine (crankshaft) revolutions per minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoluciones por minuto del motor (cigüeñal)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régime du moteur (vilebrequin) en tours par minute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发动机(曲轴)每分钟的转速。"
          }
        }
      }
    },
    "エンジンが 1 秒間に吸い込む空気の質量です。負荷とともに増えます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Luftmasse, die der Motor pro Sekunde ansaugt. Sie steigt mit der Last."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mass of air the engine draws in per second. Increases with load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa de aire que el motor aspira por segundo. Aumenta con la carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masse d'air aspirée par le moteur chaque seconde. Elle augmente avec la charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发动机每秒吸入的空气质量。会随负荷增加而增大。"
          }
        }
      }
    },
    "エンジンが出せる最大出力に対する現在の負荷の割合です。登坂や加速で高くなります。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Last als Prozentsatz der maximalen Motorleistung. Sie steigt bei Steigungen oder Beschleunigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current load as a percentage of the engine's maximum output. Rises when climbing or accelerating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentaje de la carga actual respecto a la potencia máxima que puede entregar el motor. Aumenta al subir pendientes o acelerar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourcentage de la charge actuelle par rapport à la puissance maximale que le moteur peut fournir. Il augmente en montée ou à l'accélération."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前负荷占发动机最大输出的百分比。爬坡或加速时会升高。"
          }
        }
      }
    },
    "エンジンに吸い込まれる空気の温度です。高いと出力がやや低下します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Temperatur der Luft, die in den Motor angesaugt wird. Bei hohen Werten sinkt die Leistung leicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature of the air entering the engine. Higher temperatures slightly reduce power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatura del aire que entra en el motor. Si es alta, la potencia disminuye ligeramente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Température de l'air aspiré par le moteur. Une température élevée réduit légèrement la puissance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吸入发动机的空气温度。温度较高时输出会略微下降。"
          }
        }
      }
    },
    "エンジンをかける": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the engine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca el motor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le moteur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动发动机"
          }
        }
      }
    },
    "エンジンを始動してからの経過時間です。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die seit dem Motorstart verstrichene Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time elapsed since the engine was started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo transcurrido desde que se arrancó el motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps écoulé depuis le démarrage du moteur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自发动机启动以来经过的时间。"
          }
        }
      }
    },
    "エンジンオイルの温度です。水温より暖まるのが遅く、スポーツ走行では高温に注意してください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Temperatur des Motoröls. Sie steigt langsamer als die Kühlmitteltemperatur; achten Sie bei sportlicher Fahrweise auf hohe Temperaturen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine oil temperature. Warms up more slowly than coolant; watch for high temperatures during spirited driving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatura del aceite del motor. Tarda más en calentarse que el refrigerante; preste atención a las temperaturas elevadas en conducción deportiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Température de l'huile moteur. Elle monte plus lentement que celle du liquide de refroidissement ; faites attention aux températures élevées lors d'une conduite sportive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发动机机油的温度。升温比水温慢,激烈驾驶时请注意高温。"
          }
        }
      }
    },
    "エンジンサウンド": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorsound"
          }
        },
        "en": {

    "現在地の大気圧です。海面で約 100 kPa、高地では低くなります。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Luftdruck am aktuellen Standort. Auf Meereshöhe etwa 100 kPa, in größerer Höhe niedriger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atmospheric pressure at your location. About 100 kPa at sea level, lower at altitude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión atmosférica en la ubicación actual. Es de unos 100 kPa a nivel del mar y disminuye con la altitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pression atmosphérique à l'emplacement actuel. Environ 100 kPa au niveau de la mer, plus faible en altitude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前所在地的大气压。海平面约为 100 kPa,海拔越高数值越低。"
          }
        }
      }
    },

        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulated driving data brings every gauge and engine sound to life instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con datos que simulan una conducción real, todos los medidores y el sonido del motor cobran vida al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des données de conduite simulées animent instantanément chaque cadran et le son moteur."

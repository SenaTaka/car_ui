          "stringUnit": {
            "state": "translated",
            "value": "可联动实测转速,播放经典名机的发动机声浪。"
          }
        }
      }
    },
    "実走行を再現したデータで、メーターからエンジン音まで今すぐ動きます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",

    "燃料タンクの蒸発ガスをキャニスターからエンジンへ吸わせる制御(パージ)の開度です。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Öffnungsgrad der Tankentlüftungssteuerung (Purge), die Kraftstoffdämpfe vom Aktivkohlebehälter in den Motor leitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening of the purge control, which draws fuel tank vapors from the canister into the engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apertura del control de purga, que hace pasar los vapores del depósito de combustible desde el bote de carbón hasta el motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Degré d'ouverture de la commande de purge, qui aspire les vapeurs du réservoir de carburant depuis le canister vers le moteur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将燃油箱蒸发气体从炭罐吸入发动机的控制(清污)阀开度。"
          }
        }
      }
    },

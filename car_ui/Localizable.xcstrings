    "実測の回転数に連動して、往年の名機のサウンドを鳴らせます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie legendäre Motorsounds im Takt Ihrer tatsächlichen Drehzahl erklingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendary engine sounds driven by your real RPM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce sonidos de motores legendarios sincronizados con tus RPM reales."
          }

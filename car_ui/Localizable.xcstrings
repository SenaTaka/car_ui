    "0-100 km/h 計測の完了後に「記録を保存」(Pro)で追加されます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss eines 0-100-km/h-Laufs wird er über „Lauf speichern“ (Pro) hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish a 0-100 km/h run and tap “Save Run” (Pro) to add one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirá al terminar una prueba de 0-100 km/h y pulsar «Guardar registro» (Pro)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez un chrono 0-100 km/h et appuyez sur « Enregistrer » (Pro) pour l'ajouter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 0-100 km/h 测量后,点击「保存记录」(Pro)即可添加。"
          }
        }
      }
    },

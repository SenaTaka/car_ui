    },
    "GPS 速度の計測と、走行ルートの記録に使います。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zur Messung der GPS-Geschwindigkeit und zur Aufzeichnung der Fahrtroute verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for GPS speed and recording your route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para medir la velocidad por GPS y registrar la ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour la vitesse GPS et l'enregistrement de votre trajet."
          }

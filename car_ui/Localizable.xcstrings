    "PR: リンクは Amazon アソシエイトのアフィリエイトリンクです。「ELM327」「BLE(Bluetooth 4.0/LE)対応」の表記がある製品をお選びください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung: Dieser Link ist ein Amazon-Partnerlink. Wählen Sie ein Produkt mit der Kennzeichnung „ELM327“ und „BLE (Bluetooth 4.0/LE)“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad: This is an Amazon Associates affiliate link. Choose a product labeled \"ELM327\" with \"BLE (Bluetooth 4.0/LE)\" support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncio: este enlace es un enlace de afiliado de Amazon Associates. Elige un producto que indique «ELM327» y compatibilidad con «BLE (Bluetooth 4.0/LE)»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pub : ce lien est un lien d'affiliation Amazon Associates. Choisissez un produit portant la mention « ELM327 » et compatible « BLE (Bluetooth 4.0/LE) »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告:该链接为 Amazon Associates 联盟链接。请选择标有「ELM327」「支持 BLE(Bluetooth 4.0/LE)」字样的产品。"
          }
        }
      }
    },
